{
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "target": "esnext",
    "lib": ["ESNext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "preserveConstEnums": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "alwaysStrict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "paths": {
      "@matterbridge/jest-utils": [
        "./node_modules/@matterbridge/jest-utils/dist/export.d.ts",
        "./node_modules/matterbridge/node_modules/@matterbridge/jest-utils/dist/export.d.ts"
      ],
      "@matterbridge/jest-utils/matter": [
        "./node_modules/@matterbridge/jest-utils/dist/matter.d.ts",
        "./node_modules/matterbridge/node_modules/@matterbridge/jest-utils/dist/matter.d.ts"
      ]
    }
  }
}
