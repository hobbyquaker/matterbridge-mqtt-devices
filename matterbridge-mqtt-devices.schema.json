{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "matterbridge-mqtt-devices",
  "description": "Matterbridge MQTT devices plugin configuration",
  "type": "object",
  "properties": {
    "name": {
      "description": "Plugin name",
      "type": "string"
    },
    "type": {
      "description": "Plugin type",
      "type": "string"
    },
    "broker": {
      "description": "MQTT broker URL (e.g. mqtt://192.168.1.10:1883)",
      "type": "string",
      "default": "mqtt://localhost:1883"
    },
    "username": {
      "description": "MQTT username",
      "type": "string"
    },
    "password": {
      "description": "MQTT password",
      "type": "string"
    },
    "devices": {
      "description": "List of MQTT devices to expose as Matter devices",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Device display name",
            "type": "string"
          },
          "type": {
            "description": "Device type",
            "type": "string",
            "enum": [
              "dimmable-light",
              "color-temperature-light",
              "on-off-outlet",
              "on-off-switch",
              "on-off-light",
              "dimmable-outlet",
              "generic-switch",
              "door-lock",
              "light-sensor",
              "rain-sensor",
              "water-leak-detector",
              "smoke-co-alarm",
              "soil-sensor",
              "temperature-sensor",
              "humidity-sensor",
              "contact-sensor",
              "occupancy-sensor",
              "fan",
              "cover",
              "thermostat"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ]
      }
    }
  },
  "required": []
}